# ============================================================================
# DevTrackAcademy Interview — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Service role. Bypasses RLS — server-side only, never exposed to the browser.
# The agent pipeline needs it to write blueprints, reports, skill_progress and
# agent_runs, and to read company_cache (which has RLS on and no policies).
# Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=<service role key>


# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys → Generate Key.
# Use rzp_test_* keys until you go live; the same code path handles both.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<key secret — server only, never expose>

# The SAME key id, exposed to the browser. Checkout needs it and it is public by
# design. The SECRET must never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# A DIFFERENT secret, set when you create the webhook:
# Dashboard → Account & Settings → Webhooks → Add New Webhook.
# Webhook URL:  https://<your-domain>/api/payments/webhook
# Active events: payment.captured, payment.failed, payment.authorized
RAZORPAY_WEBHOOK_SECRET=<webhook secret>


# ── Model providers ─────────────────────────────────────────────────────────
# Only the provider you actually route to needs a key. Today that is OpenAI.
OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# XAI_API_KEY=...


# ── Provider routing ────────────────────────────────────────────────────────
#
# THREE LEVELS, most specific wins:
#
#   1. AI_MODEL_<AGENT>     exact model for one agent   (beats everything)
#   2. AI_PROVIDER_<AGENT>  provider for one agent
#   3. AI_PROVIDER          provider for the whole system
#
# All three are read per request, so nothing needs a redeploy to move.

# Level 3 — the whole system in one switch. Values: openai | google | xai
AI_PROVIDER=openai

# Level 2 — move one agent to another provider. It keeps its tier, so it lands
# on that provider's equivalent model. Agent ids match agentdesign.md §1:
#   P1 P2 P3 P4 P5 P6 P7 · L1 L2 L4 · E3 E4 E5 E6 · RI
#   AI_PROVIDER_P6=google       # blueprint on Gemini, everything else on OpenAI
#   AI_PROVIDER_E4=xai          # grading on Grok

# Level 1 — pin one agent to an exact model, bypassing the tier system entirely.
# Use this to A/B a model, or to buy quality on a single agent:
#   AI_MODEL_P6=gpt-5.6-sol     # blueprint on the frontier model
#   AI_MODEL_E4=gpt-5.6-terra   # grading on the mid tier

# Per-agent timeout, in milliseconds. Worth tuning per deployment: the right
# value depends on how far the app sits from the provider, and that differs
# between a laptop and production. Only the two live-loop agents really matter.
# agentdesign.md §10 targets 550/350 assuming co-located infrastructure; the
# defaults here (1200/900) are what completes from a machine in India.
#   AI_TIMEOUT_L1=550
#   AI_TIMEOUT_L4=350

# ── Voice routes SEPARATELY from the language models ────────────────────────
# Defaults to openai no matter what AI_PROVIDER says, because only OpenAI's
# whisper-1 returns WORD-level timestamps and E2's entire speech-metrics layer
# is arithmetic over them. Switching this to google silently disables the whole
# delivery panel — GET /api/ai/status reports `wordTimestampsAvailable` so you
# can see it. Values: openai | google
#   AI_VOICE_PROVIDER=openai

# ── The ladder (lib/ai/catalog.ts is the source of truth) ───────────────────
#            nano · fast · balanced        deep
#   openai   gpt-5.6-luna                  gpt-5.6-terra
#   google   gemini-3.5-flash-lite         gemini-3.6-flash
#   xai      grok-build-0.1                grok-4.3
#
# Three tiers resolve to the same OpenAI model on purpose — they still differ in
# timeout, temperature and retries, and they diverge on other providers. Only P6
# and P7 use `deep`; the reasoning for every assignment is in lib/ai/config.ts.
#
# Voice models, OpenAI:  whisper-1 ($0.006/min, word timestamps)
#                        gpt-4o-mini-tts ($12/1M chars, accepts prosody direction)
#
# NOTE ON REASONING MODELS: the gpt-5.6 family reject `temperature` — the dial is
# `reasoningEffort` (none/minimal/low/medium/high/xhigh/max), set per agent in
# lib/ai/config.ts. Reasoning tokens are invisible in the response but billed as
# output tokens and cost real latency, which is why the two live-loop agents run
# at `none`. Gemini and Grok still honour temperature; run.ts sends whichever the
# active model actually supports.
#
# GET /api/ai/status shows live routing, prices, the active control (reasoning vs
# sampling) per agent, and voice capability.
